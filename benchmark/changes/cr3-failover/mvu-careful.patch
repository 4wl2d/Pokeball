+/** The provider in use provably did not charge: the order is charged at the secondary, or fails if it already was. */
+private fun notCharged(model: Model, order: OrderModel): Pair<Model, List<Cmd>> =
+    if (order.onSecondary) {
+        model.fail(order) to emptyList()
+    } else {
+        model.put(order.copy(stage = OrderModel.Stage.Paying, sends = 1, onSecondary = true)) to
+            listOf(Cmd.Charge(order.order.id, order.order.amount, secondary = true))
+    }
+
 private fun Model.put(order: OrderModel) = copy(orders = orders + (order.order.id to order))
 
 private fun Model.fail(order: OrderModel) = copy(stock = stock + order.order.quantity).put(order.copy(stage = OrderModel.Stage.Failed))
