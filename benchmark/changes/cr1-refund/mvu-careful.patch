+/** A confirmed refund returns the unit to stock. */
+private fun refunded(config: Config, model: Model, order: OrderModel, confirmed: Boolean): Pair<Model, List<Cmd>> = when {
+    confirmed -> model.copy(stock = model.stock + order.order.quantity).put(order.copy(stage = OrderModel.Stage.Refunded)) to emptyList()
+    order.refunds < config.maxSends -> model.put(order.copy(refunds = order.refunds + 1)) to listOf(Cmd.Refund(order.order.id, order.order.amount))
+    else -> model.put(order.copy(stage = OrderModel.Stage.NeedsAttention)) to emptyList()
+}
