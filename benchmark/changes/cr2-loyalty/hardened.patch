+package bench.hardened.adapters
+
+import bench.env.AwardStatus
+import bench.env.ConnectionRefused
+import bench.env.LoyaltyClient
+import bench.hardened.application.AwardAttempt
+import bench.hardened.application.LoyaltyGateway
+import bench.hardened.application.LoyaltyStatus
+import kotlinx.coroutines.TimeoutCancellationException
+import kotlinx.coroutines.withTimeout
+import java.io.IOException
+
+/** One request per call, no retries; failures are classified by what they prove. */
+class LoyaltyServiceGateway(private val client: LoyaltyClient, private val timeoutMillis: Long = 1_000) : LoyaltyGateway {
+    override suspend fun award(orderId: String, points: Int): AwardAttempt = try {
+        withTimeout(timeoutMillis) { client.award(orderId, points) }
+        AwardAttempt.AWARDED
+    } catch (e: ConnectionRefused) {
+        AwardAttempt.NOT_SENT
+    } catch (e: TimeoutCancellationException) {
+        AwardAttempt.UNCERTAIN
+    } catch (e: IOException) {
+        AwardAttempt.UNCERTAIN
+    }
+
+    override suspend fun status(orderId: String): LoyaltyStatus = try {
+        when (withTimeout(timeoutMillis) { client.status(orderId) }) {
+            is AwardStatus.Awarded -> LoyaltyStatus.AWARDED
+            AwardStatus.NotAwarded -> LoyaltyStatus.NOT_AWARDED
+        }
+    } catch (e: TimeoutCancellationException) {
+        LoyaltyStatus.UNAVAILABLE
+    } catch (e: IOException) {
+        LoyaltyStatus.UNAVAILABLE
+    }
+}
