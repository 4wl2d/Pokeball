+    /** AWARDING means the award may have been sent: it is sent again only after the status says it was not awarded. */
+    private suspend fun award(start: CheckoutOrder) {
+        var order = start
+        while (order.award == CheckoutOrder.Award.PENDING || order.award == CheckoutOrder.Award.AWARDING) {
+            if (order.award == CheckoutOrder.Award.AWARDING) {
+                order = when (reconcileAward(order.id)) {
+                    LoyaltyStatus.AWARDED -> order.awarded()
+                    LoyaltyStatus.NOT_AWARDED -> order.awardNotSent()
+                    LoyaltyStatus.UNAVAILABLE -> order.awardNeedsAttention()
+                }
+            } else if (order.awardSends >= maxSends) {
+                order = order.awardNeedsAttention()
+            } else {
+                order = order.awarding().also(orders::save)
+                when (loyalty.award(order.id, points)) {
+                    AwardAttempt.AWARDED -> order = order.awarded()
+                    AwardAttempt.NOT_SENT -> order = order.awardNotSent()
+                    AwardAttempt.UNCERTAIN -> Unit
+                }
+            }
+            orders.save(order)
+        }
+    }
