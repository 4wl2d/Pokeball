@@ -0,0 +1,21 @@
+package bench.layered.adapters
+
+import bench.env.LoyaltyClient
+import bench.layered.application.AwardFailedException
+import bench.layered.application.LoyaltyGateway
+import kotlinx.coroutines.TimeoutCancellationException
+import kotlinx.coroutines.withTimeout
+import java.io.IOException
+
+/** Calls the loyalty service once, with a timeout, and maps every failure to [AwardFailedException]. */
+class LoyaltyServiceGateway(private val client: LoyaltyClient, private val timeoutMillis: Long = 1_000) : LoyaltyGateway {
+    override suspend fun award(orderId: String, points: Int) {
+        try {
+            withTimeout(timeoutMillis) { client.award(orderId, points) }
+        } catch (e: TimeoutCancellationException) {
+            throw AwardFailedException("loyalty service timed out", e)
+        } catch (e: IOException) {
+            throw AwardFailedException("loyalty service unavailable", e)
+        }
+    }
+}
