+/** Calls the loyalty service and reports what each award request proves; the asker's timeout bounds the wait. */
+fun ActorSystem.loyalty(client: LoyaltyClient): ActorRef<LoyaltyCommand> = spawn { command ->
+    when (command) {
+        is LoyaltyCommand.Award -> run {
+            val reply = try {
+                client.award(command.orderId, command.points)
+                AwardReply.Awarded
+            } catch (e: ConnectionRefused) {
+                AwardReply.NotSent
+            } catch (e: IOException) {
+                AwardReply.Unknown
+            }
+            command.replyTo.complete(reply)
+        }
+        is LoyaltyCommand.QueryAward -> run {
+            runCatching { client.status(command.orderId) }
+                .fold({ command.replyTo.complete(it) }, { command.replyTo.completeExceptionally(it) })
+        }
+    }
+}
