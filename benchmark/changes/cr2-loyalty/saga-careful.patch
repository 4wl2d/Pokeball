+package bench.careful.saga.loyalty
+
+import bench.careful.saga.messages.Channels
+import bench.careful.saga.messages.LoyaltyCommand
+import bench.careful.saga.messages.SagaReply
+import bench.env.AwardStatus
+import bench.env.ConnectionRefused
+import bench.env.LoyaltyClient
+import bench.env.SimDb
+import bench.saga.kit.Message
+import bench.saga.kit.Outbox
+import bench.saga.kit.markProcessed
+import bench.saga.kit.processedBefore
+import kotlinx.coroutines.TimeoutCancellationException
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.withTimeout
+import java.io.IOException
+
+/**
+ * The loyalty participant, built like the payment participant: before it
+ * sends an award it commits an award-attempted row for the message, and a
+ * redelivered command whose row exists is answered from the service's status
+ * instead of being sent again. Each command sends at most one request; the
+ * saga decides whether to send another.
+ */
+class LoyaltyService(
+    private val db: SimDb,
+    private val client: LoyaltyClient,
+    private val horizonMillis: Long,
+    private val timeoutMillis: Long = 1_000,
+) {
+    suspend fun handle(message: Message) {
+        if (db.transaction { it.processedBefore("loyalty", message) }) return
+        val reply = when (val command = message.payload as LoyaltyCommand) {
+            is LoyaltyCommand.AwardPoints -> award(message, command)
+            is LoyaltyCommand.CheckAward -> check(command.orderId)
+        }
+        db.transaction { tx ->
+            tx.markProcessed("loyalty", message)
+            Outbox.send(tx, Channels.SAGA_REPLIES, reply)
+        }
+    }
+
+    private suspend fun award(message: Message, command: LoyaltyCommand.AwardPoints): SagaReply {
+        val attempted = "loyalty/attempted/${message.id}"
+        if (db.get(attempted) != null) return check(command.orderId)
+        db.transaction { it.put(attempted, command.orderId) }
+        return try {
+            withTimeout(timeoutMillis) { client.award(command.orderId, command.points) }
+            SagaReply.PointsAwarded(command.orderId)
+        } catch (e: ConnectionRefused) {
+            SagaReply.PointsNotAwarded(command.orderId)
+        } catch (e: TimeoutCancellationException) {
+            SagaReply.AwardUnknown(command.orderId)
+        } catch (e: IOException) {
+            SagaReply.AwardUnknown(command.orderId)
+        }
+    }
+
+    /** Waits until no earlier request can still take effect, then asks the loyalty service's status endpoint. */
+    private suspend fun check(orderId: String): SagaReply {
+        delay(horizonMillis)
+        return try {
+            when (withTimeout(timeoutMillis) { client.status(orderId) }) {
+                is AwardStatus.Awarded -> SagaReply.PointsAwarded(orderId)
+                AwardStatus.NotAwarded -> SagaReply.PointsNotAwarded(orderId)
+            }
+        } catch (e: TimeoutCancellationException) {
+            SagaReply.AwardUnknown(orderId)
+        } catch (e: IOException) {
+            SagaReply.AwardUnknown(orderId)
+        }
+    }
+}
