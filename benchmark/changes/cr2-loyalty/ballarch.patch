+package bench.ballarch.loyalty
+
+import ballarch.kernel.AdapterPort
+import ballarch.kernel.Ball
+import ballarch.kernel.Call
+import ballarch.kernel.CallKey
+import ballarch.kernel.Completion
+import ballarch.kernel.Context
+import ballarch.kernel.Decision
+import ballarch.kernel.EffectClass
+import ballarch.kernel.Notice
+import ballarch.kernel.Outcome
+import ballarch.kernel.RequestContext
+import ballarch.kernel.Step
+import ballarch.kernel.Timer
+import ballarch.kernel.outcomeOf
+import ballarch.kernel.payloadOf
+import ballarch.kernel.reject
+import ballarch.kernel.step
+import bench.ballarch.api.OrderCompletions
+import bench.env.AwardStatus
+
+data class AwardRequest(val orderId: String, val points: Int)
+
+/** The loyalty service has no idempotency keys: every delivered award awards again. */
+val LoyaltyAward = AdapterPort<AwardRequest, String>("loyalty.award", EffectClass.NonIdempotent)
+
+val LoyaltyStatus = AdapterPort<String, AwardStatus>("loyalty.status", EffectClass.Safe)
+
+sealed interface LoyaltyState {
+    data object None : LoyaltyState
+    data class Awarding(val call: CallKey, val sends: Int) : LoyaltyState
+    data class Reconciling(val call: CallKey, val sends: Int, val queries: Int) : LoyaltyState
+    data object Awarded : LoyaltyState
+    data object NeedsAttention : LoyaltyState
+}
+
+/**
+ * Awards one order's loyalty points when the checkout publishes that the order
+ * completed, with the payment Ball's policy: an award is sent again only after
+ * evidence that it did not take effect (`NotDone`, or a status read after the
+ * horizon that says so); `Unknown` starts reconciliation. It takes no requests.
+ */
+class LoyaltyBall(
+    private val points: Int,
+    private val horizonMillis: Long,
+    private val timeoutMillis: Long = 1_000,
+    private val maxSends: Int = 3,
+    private val maxQueries: Int = 3,
+) : Ball<LoyaltyState, Unit, Unit> {
+    override val type = "loyalty"
+
+    override fun initial(key: String): LoyaltyState = LoyaltyState.None
+
+    override fun decide(state: LoyaltyState, request: Unit, ctx: RequestContext): Decision<LoyaltyState, Unit> = reject(Unit)
+
+    override fun observe(state: LoyaltyState, notice: Notice<*>, ctx: Context): Step<LoyaltyState, Unit> =
+        if (notice.payloadOf(OrderCompletions) != null && state == LoyaltyState.None) send(1, ctx) else step(state)
+
+    override fun complete(state: LoyaltyState, completion: Completion<*>, ctx: Context): Step<LoyaltyState, Unit> = when {
+        state is LoyaltyState.Awarding && completion.key == state.call ->
+            when (completion.outcomeOf(LoyaltyAward)!!) {
+                is Outcome.Done -> step(LoyaltyState.Awarded)
+                is Outcome.NotDone -> resend(state.sends, ctx)
+                is Outcome.Unknown -> wait(LoyaltyState.Reconciling(ctx.newKey(), state.sends, 0))
+            }
+        state is LoyaltyState.Reconciling && completion.key == state.call -> reconcile(state, completion, ctx)
+        else -> step(state)
+    }
+
+    private fun reconcile(state: LoyaltyState.Reconciling, completion: Completion<*>, ctx: Context): Step<LoyaltyState, Unit> {
+        if (completion.outcomeOf(Timer.port) != null) {
+            val key = ctx.newKey()
+            return step(state.copy(call = key, queries = state.queries + 1), Call(key, LoyaltyStatus, ctx.self.key, timeoutMillis))
+        }
+        val status = completion.outcomeOf(LoyaltyStatus)!!
+        return when {
+            status is Outcome.Done -> if (status.value is AwardStatus.Awarded) step(LoyaltyState.Awarded) else resend(state.sends, ctx)
+            state.queries >= maxQueries -> step(LoyaltyState.NeedsAttention)
+            else -> wait(state.copy(call = ctx.newKey()))
+        }
+    }
+
+    private fun resend(sends: Int, ctx: Context) = if (sends < maxSends) send(sends + 1, ctx) else step(LoyaltyState.NeedsAttention)
+
+    private fun send(sends: Int, ctx: Context) = ctx.newKey().let { key ->
+        step<LoyaltyState, Unit>(LoyaltyState.Awarding(key, sends), Call(key, LoyaltyAward, AwardRequest(ctx.self.key, points), timeoutMillis))
+    }
+
+    private fun wait(state: LoyaltyState.Reconciling) = step<LoyaltyState, Unit>(state, Timer.after(state.call, horizonMillis))
+}
