+/** Sends the award, or sends it again after evidence that it did not take effect, within the budget. */
+private fun award(config: Config, model: Model, order: OrderModel): Pair<Model, List<Cmd>> =
+    if (order.awardSends < config.maxSends) {
+        model.put(order.copy(award = OrderModel.Award.Awarding, awardSends = order.awardSends + 1)) to listOf(Cmd.Award(order.order.id, config.points))
+    } else {
+        model.put(order.copy(award = OrderModel.Award.NeedsAttention)) to emptyList()
+    }
+
+private fun awardSent(config: Config, model: Model, order: OrderModel, outcome: AwardOutcome): Pair<Model, List<Cmd>> = when (outcome) {
